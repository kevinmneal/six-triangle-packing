  · exact False.elim (omitted_1_0_impossible p q r hp hq hr hf)
  · exact False.elim (omitted_1_1_impossible p q r hp hq hr hf)
  · exact Or.inl hf
  · exact False.elim (omitted_1_3_impossible p q r hp hq hr hf)
  · exact Or.inr hf
  · exact False.elim (omitted_1_5_impossible p q r hp hq hr hf)

theorem retained_2_of_full
    (p q r : Fin 2 → ℝ)
    (hp : p ∈ convexHull ℝ (Set.range vertices0))
    (hq : q ∈ convexHull ℝ (Set.range vertices1))
    (hr : r ∈ convexHull ℝ (Set.range vertices2))
