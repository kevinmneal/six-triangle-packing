theorem retained_0_of_full
    (p q r : Fin 2 → ℝ)
    (hp : p ∈ convexHull ℝ (Set.range vertices0))
    (hq : q ∈ convexHull ℝ (Set.range vertices1))
    (hr : r ∈ convexHull ℝ (Set.range vertices2))
    (hfull : ∃ f : Fin 6, Holds (join3 p q r) (features0 f))
    : Holds (join3 p q r) feature_0_1 ∨ Holds (join3 p q r) feature_0_4 := by
  rcases hfull with ⟨f, hf⟩
  fin_cases f
  · exact False.elim (omitted_0_0_impossible p q r hp hq hr hf)
  · exact Or.inl hf
  · exact False.elim (omitted_0_2_impossible p q r hp hq hr hf)
  · exact False.elim (omitted_0_3_impossible p q r hp hq hr hf)
  · exact Or.inr hf
  · exact False.elim (omitted_0_5_impossible p q r hp hq hr hf)

theorem retained_1_of_full
    (p q r : Fin 2 → ℝ)
    (hp : p ∈ convexHull ℝ (Set.range vertices0))
    (hq : q ∈ convexHull ℝ (Set.range vertices1))
    (hr : r ∈ convexHull ℝ (Set.range vertices2))
    (hfull : ∃ f : Fin 6, Holds (join3 p q r) (features1 f))
    : Holds (join3 p q r) feature_1_2 ∨ Holds (join3 p q r) feature_1_4 := by
