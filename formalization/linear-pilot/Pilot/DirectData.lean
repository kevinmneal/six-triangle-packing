/-- Direct exclusion from the initial support rows: no contracted polygons appear. -/
theorem initialRowsInfeasible (x : Fin 6 → ℝ) (hbase : InitialRows x)
    (hfull : FullSeparation x) : False := by
  obtain ⟨f0, h0⟩ := retained0_of_full x hbase (hfull 0)
  obtain ⟨f1, h1⟩ := retained1_of_full x hbase (hfull 1)
  obtain ⟨f2, h2⟩ := retained2_of_full x hbase (hfull 2)
  fin_cases f0 <;> fin_cases f1 <;> fin_cases f2
  · exact branch_1_2_0 x hbase h0 h1 h2
  · exact branch_1_2_2 x hbase h0 h1 h2
  · exact branch_1_2_4 x hbase h0 h1 h2
  · exact branch_1_4_0 x hbase h0 h1 h2
  · exact branch_1_4_2 x hbase h0 h1 h2
  · exact branch_1_4_4 x hbase h0 h1 h2
  · exact branch_2_2_0 x hbase h0 h1 h2
  · exact branch_2_2_2 x hbase h0 h1 h2
  · exact branch_2_2_4 x hbase h0 h1 h2
  · exact branch_2_4_0 x hbase h0 h1 h2
  · exact branch_2_4_2 x hbase h0 h1 h2
  · exact branch_2_4_4 x hbase h0 h1 h2
  · exact branch_3_2_0 x hbase h0 h1 h2
  · exact branch_3_2_2 x hbase h0 h1 h2
  · exact branch_3_2_4 x hbase h0 h1 h2
  · exact branch_3_4_0 x hbase h0 h1 h2
  · exact branch_3_4_2 x hbase h0 h1 h2
  · exact branch_3_4_4 x hbase h0 h1 h2
  · exact branch_4_2_0 x hbase h0 h1 h2
  · exact branch_4_2_2 x hbase h0 h1 h2
  · exact branch_4_2_4 x hbase h0 h1 h2
  · exact branch_4_4_0 x hbase h0 h1 h2
  · exact branch_4_4_2 x hbase h0 h1 h2
  · exact branch_4_4_4 x hbase h0 h1 h2

